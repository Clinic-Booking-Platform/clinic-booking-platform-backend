generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USERS & DOCTORS
// ============================================================
model User {
  id            Int       @id @default(autoincrement())
  full_name     String    @db.VarChar(255)
  phone_number  String?   @db.VarChar(20)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  date_of_birth DateTime? @db.Date
  gender        String?   @db.VarChar(10)

  avatar     String?   @db.VarChar(255)
  deleted_at DateTime?

  // Relations
  role         Role?         @relation(fields: [roleId], references: [id])
  roleId       Int?          @map("role_id") @db.UnsignedInt
  doctor       Doctor?
  appointments Appointment[]
  cart         Cart?
  orders       Order[]

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  users User[]

  @@map("roles")
}

model Doctor {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  specialty_id Int
  description  String?   @db.Text
  price        Decimal   @db.Decimal(12, 2)
  deleted_at   DateTime?

  // Relations
  user         User          @relation(fields: [user_id], references: [id])
  specialty    Specialty     @relation(fields: [specialty_id], references: [id])
  schedules    Schedule[]
  appointments Appointment[]
  articles     Article[]

  @@map("doctors")
}

// ============================================================
// 2. SPECIALTIES
// ============================================================
model Specialty {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String?   @db.Text
  image_url   String?   @db.VarChar(255)
  deleted_at  DateTime?

  // Relations
  doctors  Doctor[]
  articles Article[]

  @@map("specialties")
}

// ============================================================
// 3. SCHEDULES (Lịch làm việc của bác sĩ)
// ============================================================
model Schedule {
  id         Int      @id @default(autoincrement())
  doctor_id  Int
  date       DateTime @db.Date
  time_type  String   @db.VarChar(50)
  max_number Int      @default(10)
  status     String   @default("AVAILABLE") @db.VarChar(50) // AVAILABLE | FULL | CANCELLED

  // Relations
  doctor Doctor @relation(fields: [doctor_id], references: [id])

  @@map("schedules")
}
        
// ============================================================
// 4. PACKAGES & PACKAGE DETAILS (Gói khám)
// ============================================================
model Package {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  thumbnail_url  String?   @db.VarChar(255)
  price          Decimal   @db.Decimal(12, 2)
  discount_price Decimal?  @db.Decimal(12, 2)
  deleted_at     DateTime?

  // Relations
  package_detail PackageDetail?
  appointments   Appointment[]
  cart_details   CartDetail[]
  order_details  OrderDetail[]

  @@map("packages")
}

model PackageDetail {
  id           Int    @id @default(autoincrement())
  package_id   Int    @unique
  html_content String @db.LongText

  // Relations
  package Package @relation(fields: [package_id], references: [id])

  @@map("package_details")
}

// ============================================================
// 5. APPOINTMENTS (Lịch hẹn khám: Offline & Online)
// ============================================================
model Appointment {
  id               Int       @id @default(autoincrement())
  user_id          Int
  doctor_id        Int?
  package_id       Int?
  order_id         Int? // null nếu đặt Offline, có giá trị nếu đặt/thanh toán Online
  appointment_type String    @db.VarChar(50) // e.g. "OFFLINE" | "ONLINE"
  meeting_link     String?   @db.VarChar(255)
  date             DateTime  @db.Date
  time_type        String    @db.VarChar(50)
  patient_name     String    @db.VarChar(255)
  patient_phone    String    @db.VarChar(20)
  symptoms         String?   @db.Text
  status           String    @default("PENDING") @db.VarChar(50)
  deleted_at       DateTime?

  // Relations
  user           User           @relation(fields: [user_id], references: [id])
  doctor         Doctor?        @relation(fields: [doctor_id], references: [id])
  package        Package?       @relation(fields: [package_id], references: [id])
  order          Order?         @relation(fields: [order_id], references: [id])
  medical_record MedicalRecord?

  @@map("appointments")
}

// ============================================================
// 6. ARTICLES & ARTICLE DETAILS (Bài viết)
// ============================================================
model Article {
  id                Int       @id @default(autoincrement())
  author_id         Int
  specialty_id      Int?
  title             String    @db.VarChar(255)
  slug              String    @unique @db.VarChar(255)
  thumbnail_url     String?   @db.VarChar(255)
  short_description String?   @db.Text
  views             Int       @default(0)
  created_at        DateTime  @default(now())
  deleted_at        DateTime?

  // Relations
  author         Doctor         @relation(fields: [author_id], references: [id])
  specialty      Specialty?     @relation(fields: [specialty_id], references: [id])
  article_detail ArticleDetail?

  @@map("articles")
}

model ArticleDetail {
  id           Int    @id @default(autoincrement())
  article_id   Int    @unique
  html_content String @db.LongText

  // Relations
  article Article @relation(fields: [article_id], references: [id])

  @@map("article_details")
}

// ============================================================
// 7. CART & CART DETAILS (Giỏ hàng)
// ============================================================
model Cart {
  id      Int @id @default(autoincrement())
  user_id Int @unique
  sum     Int @default(0)

  // Relations
  user         User         @relation(fields: [user_id], references: [id])
  cart_details CartDetail[]

  @@map("carts")
}

model CartDetail {
  id         Int     @id @default(autoincrement())
  cart_id    Int
  package_id Int
  quantity   Int     @default(1)
  price      Decimal @db.Decimal(12, 2)

  // Relations
  cart    Cart    @relation(fields: [cart_id], references: [id])
  package Package @relation(fields: [package_id], references: [id])

  @@map("cart_details")
}

// ============================================================
// 8. ORDERS & ORDER DETAILS (Đơn hàng)
// ============================================================
model Order {
  id             Int       @id @default(autoincrement())
  user_id        Int
  order_code     String    @unique @db.VarChar(50)
  total_price    Decimal   @db.Decimal(12, 2)
  payment_method String    @db.VarChar(50)
  payment_status String    @default("UNPAID") @db.VarChar(50)
  created_at     DateTime  @default(now())
  deleted_at     DateTime?

  // Relations
  user          User          @relation(fields: [user_id], references: [id])
  order_details OrderDetail[]
  appointments  Appointment[]

  @@map("orders")
}

model OrderDetail {
  id         Int     @id @default(autoincrement())
  order_id   Int
  package_id Int
  quantity   Int     @default(1)
  price      Decimal @db.Decimal(12, 2)

  // Relations
  order   Order   @relation(fields: [order_id], references: [id])
  package Package @relation(fields: [package_id], references: [id])

  @@map("order_details")
}

// ============================================================
// 9. BANNERS
// ============================================================
model Banner {
  id         Int     @id @default(autoincrement())
  title      String  @db.VarChar(255)
  image_url  String  @db.VarChar(255)
  link_url   String? @db.VarChar(255)
  sort_order Int     @default(0)
  is_active  Boolean @default(true)

  @@map("banners")
}

// ============================================================
// 10. MEDICAL RECORDS (Hồ sơ bệnh án)
// ============================================================
model MedicalRecord {
  id             Int    @id @default(autoincrement())
  appointment_id Int    @unique // Mỗi cuộc hẹn có tối đa 1 hồ sơ bệnh án
  record_code    String @unique @db.VarChar(50) // Mã bệnh án: VD BA20260914-001

  // --- Triệu chứng & Khám lâm sàng ---
  symptoms             String? @db.Text // Triệu chứng chi tiết khi vào khám
  clinical_examination String? @db.Text // Kết quả khám lâm sàng

  // --- Chẩn đoán ---
  diagnosis  String  @db.VarChar(255) // Chẩn đoán xác định (VD: Viêm phế quản cấp)
  icd10_code String? @db.VarChar(20) // Mã bệnh ICD-10 (VD: J20)
  icd10_name String? @db.VarChar(255) // Tên bệnh theo ICD-10

  // --- Sinh hiệu (Vital Signs) ---
  blood_pressure String?  @db.VarChar(20) // Huyết áp (VD: "120/80")
  pulse          Int? // Mạch (lần/phút)
  temperature    Decimal? @db.Decimal(4, 1) // Nhiệt độ (°C, VD: 37.2)
  weight         Decimal? @db.Decimal(5, 2) // Cân nặng (kg)
  height         Decimal? @db.Decimal(5, 2) // Chiều cao (cm)

  // --- Lời dặn & Tái khám ---
  doctor_advice       String?   @db.Text // Lời dặn chế độ ăn uống, nghỉ ngơi
  re_examination_date DateTime? @db.Date // Hẹn ngày tái khám

  // --- Hình thức khám ---
  consultation_type String  @default("OFFLINE") @db.VarChar(20) // "OFFLINE" hoặc "ONLINE"
  recommendation    String? @db.Text // Khuyến nghị: "Cần đến khám trực tiếp", "Tự theo dõi tại nhà"

  // --- Ký & Đóng hồ sơ ---
  status    String    @default("DRAFT") @db.VarChar(20) // "DRAFT" | "SIGNED"
  signed_at DateTime? // Thời điểm bác sĩ ký xác nhận đóng hồ sơ

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  appointment   Appointment               @relation(fields: [appointment_id], references: [id])
  prescriptions PrescriptionItem[]
  attachments   MedicalRecordAttachment[]

  @@map("medical_records")
}

// ============================================================
// 11. PRESCRIPTION ITEMS (Chi tiết đơn thuốc)
// ============================================================
model PrescriptionItem {
  id                Int     @id @default(autoincrement())
  medical_record_id Int
  medicine_name     String  @db.VarChar(255) // Tên thuốc (VD: Paracetamol 500mg)
  dosage            String  @db.VarChar(100) // Liều dùng (VD: Sáng 1 viên, Tối 1 viên)
  quantity          Int // Số lượng (VD: 10)
  unit              String  @db.VarChar(50) // Đơn vị (viên, gói, chai)
  instructions      String? @db.VarChar(255) // Hướng dẫn: Uống sau khi ăn no

  // Relations
  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

// ============================================================
// 12. MEDICAL RECORD ATTACHMENTS (Tệp đính kèm: Xét nghiệm, X-quang)
// ============================================================
model MedicalRecordAttachment {
  id                Int      @id @default(autoincrement())
  medical_record_id Int
  file_url          String   @db.VarChar(500) // Đường dẫn file
  file_name         String   @db.VarChar(255) // Tên file gốc
  description       String?  @db.VarChar(255) // Mô tả (VD: Kết quả xét nghiệm máu)
  created_at        DateTime @default(now())

  // Relations
  medical_record MedicalRecord @relation(fields: [medical_record_id], references: [id], onDelete: Cascade)

  @@map("medical_record_attachments")
}
